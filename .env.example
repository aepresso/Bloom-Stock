# Copy to .env and fill in. .env is gitignored.
# OpenRouter API key used for receipt parsing (SPEC §5.4) — routes to a Claude
# model via OpenRouter's OpenAI-compatible API.
# NOTE: EXPO_PUBLIC_* vars are inlined into the JS bundle and extractable from
# the built IPA. Acceptable only for this single-user personal app.
EXPO_PUBLIC_OPENROUTER_API_KEY=
